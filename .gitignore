.pixi/
.pytest_cache/
**/__pycache__/
*.py[cod]

# Frozen resources are local, large and may have redistribution restrictions.
resources/data/

# Local projects, inputs, runtime and published results are not template source.
projects/*
!projects/_template/
!projects/_template/**

# Local logs and editor files.
*.log
.DS_Store
Thumbs.db
.snakemake/

# Project-specific legacy script snapshots remain local audit material. The
# portable template keeps only the generic migration-artifact explanation.
internal/migration_artifacts/*/
